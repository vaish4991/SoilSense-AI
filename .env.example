# ─────────────────────────────────────────────
# SoilSense AI — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# LLM Providers (system tries Gemini first, falls back to OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML
MODEL_PATH=backend/ml/model/soil_ph_model.joblib

# Weather (Open-Meteo is free, no key required)
WEATHER_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=INFO

# Firebase Auth (Optional - enable live Firebase Authentication & Google OAuth)
# If omitted or left blank, the app will run in Demo Auth Mode with full functionality
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
